# Comma-separated ids of the sites where real writes (dryRun: false) are allowed.
WEBFLOW_WRITE_ALLOWED_SITES=

# Sandbox site used by the tests (npm test) and the benchmark. Never a client site.
WEBFLOW_SANDBOX_SITE_ID=

# Hosted MCP (mcp.webflow.com, OAuth, no token, default): authorization profile. An authorization covers the sites
# ticked during `npm run hosted-login`; one profile per scope (e.g. sandbox, client-x). Default: default.
# Projects run through bin/kit get their own authorization automatically.
WEBFLOW_HOSTED_PROFILE=

# Server: empty = hosted MCP; "local" = npm server webflow-mcp-server with WEBFLOW_TOKEN (Data API only).
WEBFLOW_BACKEND=

# Local server only: Webflow API token of the target site (Site settings → Apps & integrations → API access).
# One token per site: the token determines which site is reachable.
WEBFLOW_TOKEN=

# Local server only: version of the MCP server started by the library (default: latest).
WEBFLOW_MCP_VERSION=latest

# Figma: personal read token (Settings → Security → Personal access tokens). Sections of a full page, section
# comments, SVG export. Never commit it.
FIGMA_TOKEN=
