{
  "name": "mcp-code-mode-webflow-figma",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.3"
  },
  "scripts": {
    "dump-schemas": "tsx scripts/dump-schemas.ts",
    "codegen": "tsx scripts/codegen.ts",
    "regen": "npm run dump-schemas && npm run codegen",
    "usage": "tsx scripts/analyze-usage.ts",
    "typecheck": "tsc --noEmit",
